{
  "name": "siege",
  "private": true,
  "version": "0.1.0",
  "description": "Siège — jeu de stratégie tour par tour médiéval (Three.js / React Three Fiber)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "bench:perf": "node scripts/perf-bench.ts",
    "bench:core": "node scripts/core-bench.ts",
    "capture:lookdev": "node scripts/capture-lookdev.ts",
    "assets:characters": "blender -b --factory-startup --python scripts/blender/convert_rpg_characters.py -- \"assets-src/raw/lowpoly-rpg-characters/RPG Characters - Nov 2020\" assets-src/work/rpg",
    "assets:process": "node scripts/process-assets.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "@react-three/postprocessing": "3.1.2",
    "@react-three/rapier": "2.2.0",
    "@three.ez/instanced-mesh": "0.3.16",
    "howler": "2.2.4",
    "idb-keyval": "6.3.0",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simplex-noise": "4.0.3",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/howler": "2.2.13",
    "@types/node": "24.x",
    "@types/react": "19.2.x",
    "@types/react-dom": "19.2.x",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "leva": "0.10.1",
    "meshoptimizer": "1.2.0",
    "sharp": "^0.35.4",
    "stats-gl": "4.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
